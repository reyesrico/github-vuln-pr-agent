# Copy this file to local .env for rollout automation.
# Then run:
# ./scripts/rollout-actions.sh owner/repo .env --dispatch

# Required secret (or set GITHUB_TOKEN and script will map it)
SECURITY_AGENT_GITHUB_TOKEN=

# Required variables
ALERT_REPOSITORIES=reyesrico/CovidCharts,reyesrico/workshop-app,reyesrico/react-test
DRY_RUN=true
VULN_SEVERITIES=critical,high,moderate
BRANCH_PREFIX=chore/security
MAX_ALERTS_PER_REPO=3
REPO_COMMANDS={}
EMAIL_ENABLED=true
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false

# Required only when EMAIL_ENABLED=true
EMAIL_TO=reyesrico@hotmail.com
EMAIL_FROM=reyesrico@hotmail.com
SMTP_USER=reyesrico@hotmail.com
SMTP_PASS=
