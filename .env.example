# Required
GITHUB_TOKEN=ghp_xxx
ALERT_REPOSITORIES=reyesrico/CovidCharts,reyesrico/workshop-app,reyesrico/react-test

# Optional fallback: paste full GitHub notification email text
RAW_GITHUB_EMAIL=

# Optional behavior
DRY_RUN=true
VULN_SEVERITIES=critical,high,moderate
BRANCH_PREFIX=chore/security
MAX_ALERTS_PER_REPO=3

# Optional per-repo commands (JSON)
# REPO_COMMANDS={"reyesrico/CovidCharts":{"install":"npm install","lint":"npm run lint --if-present","test":"npm test --if-present"}}
REPO_COMMANDS={}

# Email notifications
EMAIL_ENABLED=true
EMAIL_TO=reyesrico@hotmail.com
EMAIL_FROM=reyesrico@hotmail.com
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=reyesrico@hotmail.com
SMTP_PASS=your-app-password
