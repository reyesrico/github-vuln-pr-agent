# Required
GITHUB_TOKEN=ghp_xxx
ACCOUNT_LOGIN=your_account

# Optional repository targeting:
# 1) Set ALERT_REPOSITORIES for explicit repo list, or
# 2) Set RAW_GITHUB_EMAIL with a fresh GitHub advisory email to process only that event,
# 3) Leave both empty to auto-discover all owned repositories for GITHUB_TOKEN.
ALERT_REPOSITORIES=

# Optional fallback: paste full GitHub notification email text
RAW_GITHUB_EMAIL=
# Optional structured signal payload (JSON) for listener dispatch simulation
# Example: {"repository":"your_account/repo1","cve_ids":["CVE-2026-12345"],"ghsa_ids":["GHSA-xxxx-yyyy-zzzz"],"dependency_names":["lodash"]}
ADVISORY_SIGNAL_PAYLOAD=
# Signal gate behavior:
# - false: process open alerts automatically (recommended for unattended runs)
# - true: process only alerts matching RAW_GITHUB_EMAIL or ADVISORY_SIGNAL_PAYLOAD
# Local dev tip:
# - use false for normal dry-run testing
# - use true for production listener mode and specific advisory simulation
PROCESS_ONLY_EMAIL_SIGNAL=true

# Optional behavior
DRY_RUN=true
VULN_SEVERITIES=critical,high,moderate
BRANCH_PREFIX=chore/security
MAX_ALERTS_PER_REPO=3
INSTALL_RETRY_WITH_LEGACY_PEER_DEPS=true

# Optional per-repo commands (JSON)
# REPO_COMMANDS={"your_account/repo1":{"install":"npm install","lint":"npm run lint --if-present","test":"npm test --if-present"}}
REPO_COMMANDS={}

# Email notifications
EMAIL_ENABLED=true
EMAIL_FAIL_OPEN=true
# Required only when EMAIL_ENABLED=true
EMAIL_TO=review-inbox@example.com
EMAIL_FROM=security-agent@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=security-agent@example.com
SMTP_PASS=your-app-password

# E2E recommendation simulation (same .env file)
E2E_TARGET_REPO=your_account/repo1
E2E_LIBRARY=is-odd
E2E_LIBRARY_VERSION=3.0.1
E2E_RAW_EMAIL=Subject: recommendation\nPlease add is-odd to your_account/repo1
E2E_EMAIL_MODE=smtp
E2E_FLOW_MODE=add-only-close
E2E_AUTO_CLOSE_ON_ERROR=true
